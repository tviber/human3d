{
  "name": "@human3d/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Loopback-only Motion Protocol v1 service: HTTP transport, Ajv request/package contract, node:crypto identity and asset loading.",
  "exports": {
    ".": "./src/index.ts",
    "./rig-manifest": "./src/rig-manifest.ts",
    "./serve": "./src/serve.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "preserve": "sh ../../scripts/check-process-limit.sh",
    "serve": "node --import tsx src/serve.ts"
  },
  "dependencies": {
    "@human3d/motion-core": "*",
    "ajv": "^8.20.0",
    "three": "^0.180.0"
  }
}
