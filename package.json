{
  "name": "human3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web"],
  "scripts": {
    "predev": "sh scripts/check-process-limit.sh",
    "prebuild": "sh scripts/check-process-limit.sh",
    "prepreview": "sh scripts/check-process-limit.sh",
    "dev": "cd apps/web && vite --config vite.config.ts",
    "build": "tsc --noEmit && cd apps/web && vite build --config vite.config.ts",
    "preview": "cd apps/web && vite preview --config vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {"node": ">=22.12.0"},
  "allowScripts": {"esbuild@0.28.2": true}
}
